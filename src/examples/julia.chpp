fun main() { 
    renderCoolJulia() 
    return 
} 

fun wave(t) { 
    let x = t % 200 
    if x < 0 { 
        x = x + 200 
    } 
    if x < 100 { 
        return (x * (100 - x)) / 25 
    } 
    let y = x - 100 
    return -(y * (100 - y)) / 25 
} 

fun juliaIter(zx, zy, cx, cy) { 
    let iter = 0 
    let maxIter = 120 // Lowered slightly for faster rendering on a smaller canvas
    
    while iter < maxIter & (zx * zx + zy * zy) <= 4.0 { 
        let temp = 0.0
        
        if iter % 2 == 0 {
            temp = (zx * zx - zy * zy) + cx 
            zy = (2.0 * zx * zy) + cy 
        } else {
            let absX = zx
            if absX < 0.0 { absX = -absX }
            let absY = zy
            if absY < 0.0 { absY = -absY }
            temp = (absX * absX - absY * absY) + cx
            zy = (2.0 * absX * absY) + cy
        }
        
        zx = temp 
        iter = iter + 1 
    } 
    return iter 
} 

fun rgbValues(iter) { 
    if iter == 120 { 
        return "10;12;24" 
    } 
    
    let scaledIter = (iter * 4) // Increased multiplier to keep colors vibrant at 120 maxIter
    let r = 127 + (wave(scaledIter + 10) * 127) / 100 
    let g = 127 + (wave(scaledIter + 75) * 127) / 100 
    let b = 127 + (wave(scaledIter + 140) * 127) / 100 
    
    if r < 0 { r = 0 } 
    if r > 255 { r = 255 } 
    if g < 0 { g = 0 } 
    if g > 255 { g = 255 } 
    if b < 0 { b = 0 } 
    if b > 255 { b = 255 } 
    
    return "" + r + ";" + g + ";" + b 
} 

fun renderCoolJulia() { 
    // Narrowed coordinate windows and increased steps to compress terminal width
    let y = -1.0 
    let stepX = 0.016
    let stepY = 0.016 
    
    while y <= 1.0 { 
        let row = "" 
        let x = -1.7 
        
        let cx = -0.7 + (y * 0.05)
        let cy = 0.27015 + (y * 0.02)
        
        while x <= 1.3 { 
            let iterTop = juliaIter(x, y, cx, cy) 
            let iterBot = juliaIter(x, y + stepY, cx, cy) 
            
            let topRgb = rgbValues(iterTop) 
            let botRgb = rgbValues(iterBot) 
            
            row = row + "\u001B[38;2;" + topRgb + "m\u001B[48;2;" + botRgb + "m▀" 
            x = x + stepX 
        } 
        row = row + "\u001B[0m" 
        print(row) 
        y = y + (stepY * 2.0) 
    } 
    return 
}

fun main() {
    renderTrueColorMandelbrot()
    return
}

fun wave(t) {
    let x = t % 200
    if x < 0 {
        x = x + 200
    }
    if x < 100 {
        return (x * (100 - x)) / 25
    }
    let y = x - 100
    return -(y * (100 - y)) / 25
}

fun mandelIter(cx, cy) {
    let zr = 0
    let zi = 0
    let iter = 0
    let maxIter = 200
    while iter < maxIter & ((zr * zr + zi * zi) / 10000) <= 40000 {
        let temp = ((zr * zr - zi * zi) / 10000) + cx
        zi = ((2 * zr * zi) / 10000) + cy
        zr = temp
        iter = iter + 1
    }
    return iter
}

fun rgbValues(iter) {
    if iter == 200 {
        return "0;0;0"
    }
    // Scale iteration by 2 so the color wave maps beautifully to a maxIter of 200
    let scaledIter = (iter * 2)
    let r = 127 + (wave(scaledIter + 0) * 127) / 100
    let g = 127 + (wave(scaledIter + 66) * 127) / 100
    let b = 127 + (wave(scaledIter + 133) * 127) / 100
    
    if r < 0 { r = 0 } if r > 255 { r = 255 }
    if g < 0 { g = 0 } if g > 255 { g = 255 }
    if b < 0 { b = 0 } if b > 255 { b = 255 }
    return "" + r + ";" + g + ";" + b
}

fun renderTrueColorMandelbrot() {
    let y = -11500
    let stepX = 90
    let stepY = 90
    while y <= 11500 {
        let row = ""
        let x = -21000
        while x <= 8000 {
            let iterTop = mandelIter(x, y)
            let iterBot = mandelIter(x, y + stepY)
            let topRgb = rgbValues(iterTop)
            let botRgb = rgbValues(iterBot)
            row = row + "\u001B[38;2;" + topRgb + "m\u001B[48;2;" + botRgb + "m▀"
            x = x + stepX
        }
        row = row + "\u001B[0m"
        print(row)
        y = y + (stepY * 2)
    }
    return
}

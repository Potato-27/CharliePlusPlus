let x = 50
let y = "hello, "
let count = 0


fun main(){
    functionTest()

    x = 15
    functionTest()

    x = 75
    functionTest()

    print(y + "world!")

    print("")

    while count < 10 {
        print(count)
        count = count + 1
    }
}

fun functionTest(){
    if x >= 60 {
        print("greater than or equal to 60")
    } else if (x < 30) {
        print("less than 30")
    } else {
        print("neither is true")
    }
}